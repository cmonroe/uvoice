#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# uvoice - native voice stack for OpenWrt
# Copyright (C) 2026 Adtran Inc.
# Author: Chad Monroe <chad.monroe@adtran.com>
#
# Licensed under GPL-2.0-only with the linking exception stated in LICENSE.
#
# uci-defaults step that deletes the Allow_VoIP_* rules of the other voice
# stack. uvoiced admits SIP peers through its nft sets and writes no firewall
# rule, so an Allow_VoIP_* rule only opens a port. The step leaves
# restrict_source as written: uvoice accepts the option for the other stack
# and acts on none of its values.

STACK_LIB=/usr/srg/scripts/voice-stack.sh

# The other voice stack owns the Allow_VoIP_* rules, so the step acts only
# when the platform selects uvoice. uvoice.init uses the same voice_stack_get
# answer.
if [ -r "$STACK_LIB" ]; then
	# shellcheck source=/dev/null
	. "$STACK_LIB"
else
	voice_stack_get() { echo none; }
fi
# A nonzero exit keeps the step, so a board that moves to uvoice later runs it.
[ "$(voice_stack_get)" = uvoice ] || exit 1

firewall_changed=0

# A delete moves the next rule to the same index, so the index advances only
# past a rule that stays.
i=0
while uci -q get "firewall.@rule[$i]" >/dev/null; do
	case "$(uci -q get "firewall.@rule[$i].name")" in
	Allow_VoIP_*)
		if uci -q delete "firewall.@rule[$i]"; then
			firewall_changed=1
			continue
		fi
		;;
	esac
	i=$((i + 1))
done

[ "$firewall_changed" = 1 ] && uci -q commit firewall

exit 0

#
# Input rules that accept SIP traffic for each element of the uvoice sets
# (table-pre/20-uvoice.nft). fw4 puts them ahead of its zone jumps.
meta l4proto udp iifname . ip saddr . udp dport @uvoice_peer4 accept comment "uvoice: pinged SIP peer"
meta l4proto udp iifname . ip6 saddr . udp dport @uvoice_peer6 accept comment "uvoice: pinged SIP peer"
